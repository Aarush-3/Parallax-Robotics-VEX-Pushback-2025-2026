from vex import *
# FINAL DRIVER CONTROL - REFER TO THIS WHILE AS MAIN WHEN MAKING CHANGES - tk
# ---------------- BRAIN & CONTROLLER ----------------
brain = Brain()
controller = Controller()

# ---------------- DRIVETRAIN ----------------
left_motor_a = Motor(Ports.PORT11, GearSetting.RATIO_18_1, False)
left_motor_b = Motor(Ports.PORT12, GearSetting.RATIO_18_1, False)
left_drive = MotorGroup(left_motor_a, left_motor_b)

right_motor_a = Motor(Ports.PORT13, GearSetting.RATIO_18_1, True)
right_motor_b = Motor(Ports.PORT14, GearSetting.RATIO_18_1, True)
right_drive = MotorGroup(right_motor_a, right_motor_b)

drivetrain = DriveTrain(
    left_drive,
    right_drive,
    12.56,   # wheel travel (in)
    12.5,    # track width (in)
    DistanceUnits.IN
)

# ---------------- DRIVER CONTROL ----------------
def user_control():
    drivetrain.set_stopping(BrakeType.BRAKE)

    DRIVE_SPEED = 100
    MECH_SPEED = 100

    while True:
        # ----- ARCADE DRIVE -----
        throttle = controller.axis3.position()
        steering = controller.axis1.position()

        left_drive.spin(FORWARD, throttle + steering, PERCENT)
        right_drive.spin(FORWARD, throttle - steering, PERCENT)

       

        wait(20, MSEC)

# ---------------- AUTON PLACEHOLDER ----------------
def autonomous():
    pass

# ---------------- COMPETITION ----------------
competition = Competition(user_control, autonomous)
