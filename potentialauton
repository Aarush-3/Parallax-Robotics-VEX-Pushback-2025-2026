# ------------------------------------------
# V5RC Push Back — 60s Skills Autonomous
# Strategy: Center + Scrap Cycles
# Sensors: Inertial + Distance
# ------------------------------------------

from vex import *
import urandom

# ---------------- Brain / Controller ----------------
brain = Brain()
Controller1 = Controller()

# ---------------- Drivetrain ----------------
LeftMotor  = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)
RightMotor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, True)
Drivetrain = DriveTrain(LeftMotor, RightMotor, 12.56, 12.5, DistanceUnits.IN)

# ---------------- Mechanisms ----------------
ConveyorBelt = Motor(Ports.PORT3, GearSetting.RATIO_18_1, False)
IntakeMain   = Motor(Ports.PORT4, GearSetting.RATIO_18_1, False)
IntakePortD  = Motor(Ports.PORT5, GearSetting.RATIO_18_1, False)

# ---------------- Sensors ----------------
inertial_sensor = Inertial(Ports.PORT8)
dist_sensor     = Distance(Ports.PORT9)

# ---------------- Random Seed ----------------
def initializeRandomSeed():
    wait(100, MSEC)
    r = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100
    urandom.seed(int(r))

initializeRandomSeed()

# ---------------- Intake Helpers ----------------
def intake_on():
    IntakeMain.spin(FORWARD, 100, PERCENT)
    IntakePortD.spin(FORWARD, 100, PERCENT)
    ConveyorBelt.spin(FORWARD, 100, PERCENT)

def intake_off():
    IntakeMain.stop(HOLD)
    IntakePortD.stop(HOLD)
    ConveyorBelt.stop(HOLD)

def score(duration_ms=1800):
    IntakeMain.spin(REVERSE, 100, PERCENT)
    IntakePortD.spin(REVERSE, 100, PERCENT)
    ConveyorBelt.spin(REVERSE, 100, PERCENT)
    wait(duration_ms, MSEC)
    intake_off()

# ---------------- Motion Helpers ----------------
def set_drive(speed=65, turn=45):
    Drivetrain.set_drive_velocity(speed, PERCENT)
    Drivetrain.set_turn_velocity(turn, PERCENT)

def wrap180(angle):
    while angle >= 180:
        angle -= 360
    while angle < -180:
        angle += 360
    return angle

def turn_to(target, speed=35, timeout=2500):
    Drivetrain.set_turn_velocity(speed, PERCENT)
    t = Timer()
    t.reset()

    while t.time(MSEC) < timeout:
        cur = inertial_sensor.heading(DEGREES)
        err = wrap180(target - cur)

        if abs(err) < 2:
            Drivetrain.stop(BRAKE)
            return

        if err > 0:
            Drivetrain.turn_for(RIGHT, min(abs(err), 10), DEGREES)
        else:
            Drivetrain.turn_for(LEFT, min(abs(err), 10), DEGREES)

        wait(10, MSEC)

    Drivetrain.stop(BRAKE)

def drive_until(max_inches, stop_dist=4.0, speed=45):
    Drivetrain.set_drive_velocity(speed, PERCENT)
    traveled = 0

    while traveled < max_inches:
        d = dist_sensor.object_distance(INCHES)
        if d > 0 and d <= stop_dist:
            Drivetrain.stop(BRAKE)
            return

        Drivetrain.drive_for(FORWARD, 2, INCHES)
        traveled += 2
        wait(5, MSEC)

# ---------------- Autonomous ----------------
def autonomous():

    inertial_sensor.calibrate()
    while inertial_sensor.is_calibrating():
        wait(25, MSEC)
    inertial_sensor.set_heading(0, DEGREES)

    Drivetrain.set_stopping(BRAKE)
    set_drive()

    start_time = brain.timer.time(SECONDS)

    # ---------- SKILLS LOOP ----------
    while brain.timer.time(SECONDS) - start_time < 58:

        # --- Go to center ---
        intake_on()
        turn_to(0)
        Drivetrain.drive_for(FORWARD, 30, INCHES)

        # Sweep right scrap
        turn_to(25)
        Drivetrain.drive_for(FORWARD, 14, INCHES)

        # Sweep left scrap
        turn_to(335)
        Drivetrain.drive_for(FORWARD, 14, INCHES)

        # Return heading
        turn_to(0)

        # --- Return to goal ---
        Drivetrain.drive_for(REVERSE, 32, INCHES)

        # Final approach using distance sensor
        drive_until(22, stop_dist=3.5)

        # Score
        score(1800)

        # Back out
        Drivetrain.drive_for(REVERSE, 10, INCHES)
        intake_off()

    Drivetrain.stop(BRAKE)

# ---------------- Driver Control ----------------
def user_control():
    Drivetrain.set_stopping(BRAKE)
    while True:
        throttle = Controller1.axis3.position()
        steering = Controller1.axis1.position()
        LeftMotor.spin(FORWARD, throttle + steering, PERCENT)
        RightMotor.spin(FORWARD, throttle - steering, PERCENT)
        wait(20, MSEC)

# ---------------- Competition ----------------
competition = Competition(user_control, autonomous)
