# ------------------------------------------
# V5RC Push Back — Skills (Updated Dimensions)
# Robot Length: 17.5 inches
# Sensor: REAR-mounted Distance
# ------------------------------------------

from vex import *

# --- 1. DEVICE CONFIGURATION ---
brain = Brain()

LeftMotor  = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)
RightMotor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, True)
Drivetrain = DriveTrain(LeftMotor, RightMotor, 12.56, 12.5, DistanceUnits.IN)

ConveyorBelt = Motor(Ports.PORT3, GearSetting.RATIO_18_1, False)
IntakeMain   = Motor(Ports.PORT4, GearSetting.RATIO_18_1, False)
IntakePort5  = Motor(Ports.PORT5, GearSetting.RATIO_18_1, False)

inertial_sensor = Inertial(Ports.PORT8)
dist_sensor     = Distance(Ports.PORT9)

ROBOT_LENGTH_IN = 17.5 

Controller1 = Controller()

# --- 2. MOVEMENT HELPERS ---

def intake_on():
    IntakeMain.spin(FORWARD, 100, PERCENT)
    IntakePort5.spin(FORWARD, 100, PERCENT)
    ConveyorBelt.spin(FORWARD, 100, PERCENT)

def intake_off():
    IntakeMain.stop(HOLD)
    IntakePort5.stop(HOLD)
    ConveyorBelt.stop(HOLD)

def reverse_until_front_clearance(front_target_in=3.5):
    """
    Stops the robot based on the new 17.5" length.
    Threshold = 3.5 + 17.5 = 21.0 inches from the rear sensor.
    """
    Drivetrain.set_drive_velocity(30, PERCENT)
    
    # The math updates automatically here
    rear_stop_threshold = front_target_in + ROBOT_LENGTH_IN
    
    Drivetrain.drive(REVERSE)
    while True:
        if dist_sensor.object_distance(DistanceUnits.IN) >= rear_stop_threshold:
            Drivetrain.stop(BRAKE)
            break
        wait(10, MSEC)

# --- 3. THE 60-SECOND SKILLS ROUTINE ---

def autonomous():
    # Calibration
    inertial_sensor.calibrate()
    while inertial_sensor.is_calibrating():
        wait(25, MSEC)
    
    # Slant correction (4.5 degrees left)
    inertial_sensor.set_heading(-4.5, DEGREES)
    wait(1, SECONDS)
    
    start_time = brain.timer.time(SECONDS)

    while brain.timer.time(SECONDS) - start_time < 58:
        intake_on()

        # Align to center
        Drivetrain.turn_to_heading(0, DEGREES) 
        
        # Drive to balls
        Drivetrain.drive_for(FORWARD, 30, DistanceUnits.IN)
        
        # Sweep maneuvers
        Drivetrain.turn_to_heading(25, DEGREES)
        Drivetrain.drive_for(FORWARD, 12, DistanceUnits.IN)
        Drivetrain.turn_to_heading(335, DEGREES)
        Drivetrain.drive_for(FORWARD, 12, DistanceUnits.IN)

        # Return and Score
        Drivetrain.turn_to_heading(0, DEGREES)
        Drivetrain.drive_for(REVERSE, 24, DistanceUnits.IN)
        
        # Uses the new 17.5" logic to find the goal
        reverse_until_front_clearance(3.5)

        # Score
        IntakeMain.spin(REVERSE, 100, PERCENT)
        IntakePort5.spin(REVERSE, 100, PERCENT)
        ConveyorBelt.spin(REVERSE, 100, PERCENT)
        wait(1.8, SECONDS)
        intake_off()

        # Reset
        Drivetrain.drive_for(FORWARD, 6, DistanceUnits.IN)

# --- 4. DRIVER CONTROL ---
def user_control():
    while True:
        throttle = Controller1.axis3.position()
        steering = Controller1.axis1.position()
        LeftMotor.spin(FORWARD, throttle + steering, PERCENT)
        RightMotor.spin(FORWARD, throttle - steering, PERCENT)
        wait(20, MSEC)

competition = Competition(user_control, autonomous)
